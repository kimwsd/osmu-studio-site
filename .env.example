# Existing public anon configuration is retained as a fallback in lib/public-config.json.
# Override these when moving the site to another Supabase project.
# Never put a service-role key here. The site uses existing anonymous RLS permissions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
